# Python bytecode (regenerated on every run)
__pycache__/
*.pyc

# Training and Hydra logs (final weights are copied into assignments/*/checkpoints)
/logs/
/outputs/

# Large or regenerated assignment files
assignments/*/data/
assignments/*/checkpoints/**/exported/
assignments/*/checkpoints/**/videos/
assignments/*/results/dynamics/window_errors_*.pt
assignments/*/results/raw/main/*_traces.npz
assignments/*/results/raw/grid/*_traces.npz
assignments/*/results/raw/calib/*_traces.npz
assignments/*/results/raw/diag_height/*_traces.npz
assignments/*/results/raw/main_D_without_norms/*_traces.npz
